@model List<GestionStagiaires.Models.DocumentStagiaire>

@{
    ViewData["Title"] = "Mes documents";
}

<div class="mb-4">
    <h1 class="fw-bold mb-1">
        <i class="bi bi-folder2-open me-2"></i>
        Mes documents
    </h1>

    <p class="text-muted mb-0">
        Consultez et téléchargez les documents déposés par le responsable.
    </p>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Aucun document n’est disponible pour le moment.
    </div>
}
else
{
    <div class="row g-4">

        @foreach (var document in Model)
        {
            <div class="col-md-6 col-lg-4">

                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">

                        <div class="onee-icon-box mb-3">
                            <i class="bi bi-file-earmark-pdf-fill"></i>
                        </div>

                        <h5 class="fw-bold">
                            @document.NomDocument
                        </h5>

                        <p class="text-muted small text-break">
                            @document.NomFichier
                        </p>

                        <p class="text-muted">
                            Déposé le
                            @(document.DateDepot
                                .ToString("dd/MM/yyyy à HH:mm"))
                        </p>

                        <a href="@document.CheminFichier"
                           target="_blank"
                           class="btn btn-primary">

                            <i class="bi bi-download me-1"></i>
                            Télécharger
                        </a>

                    </div>
                </div>

            </div>
        }

    </div>
}