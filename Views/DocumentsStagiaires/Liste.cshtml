@model List<GestionStagiaires.Models.DocumentStagiaire>

@{
    ViewData["Title"] = "Documents du stagiaire";

    var stagiaire =
        ViewBag.Stagiaire as GestionStagiaires.Models.Stagiaire;
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="fw-bold mb-1">
            <i class="bi bi-folder-fill me-2"></i>
            Documents du stagiaire
        </h1>

        <p class="text-muted mb-0">
            @stagiaire?.Prenom @stagiaire?.Nom
        </p>
    </div>

    <a asp-action="Depot"
       asp-route-stagiaireId="@stagiaire?.Id"
       class="btn btn-success">
        <i class="bi bi-cloud-arrow-up-fill me-1"></i>
        Déposer un document
    </a>

</div>

@if (TempData["Succes"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Succes"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Aucun document n’a encore été déposé pour ce stagiaire.
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-dark">
                    <tr>
                        <th>Document</th>
                        <th>Fichier</th>
                        <th>Date de dépôt</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var document in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @document.NomDocument
                            </td>

                            <td>
                                <i class="bi bi-file-earmark-pdf-fill
                                           text-danger me-1">
                                </i>

                                @document.NomFichier
                            </td>

                            <td>
                                @(document.DateDepot
                                    .ToString("dd/MM/yyyy HH:mm"))
                            </td>

                            <td>
                                <a href="@document.CheminFichier"
                                   target="_blank"
                                   class="btn btn-sm btn-outline-primary">

                                    <i class="bi bi-download me-1"></i>
                                    Télécharger
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>
}

<div class="mt-3">
    <a asp-controller="Stagiaires"
       asp-action="Details"
       asp-route-id="@stagiaire?.Id"
       class="btn btn-secondary">
        Retour au stagiaire
    </a>
</div>