@model GestionStagiaires.Models.DemandeDocument

@{
    ViewData["Title"] = "Détails de ma demande";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="card border-0 shadow-sm">

            <div class="card-header bg-dark text-white">
                <h3 class="mb-0">
                    <i class="bi bi-file-earmark-text-fill me-2"></i>
                    Détails de ma demande
                </h3>
            </div>

            <div class="card-body p-4">

                <div class="row g-4">

                    <div class="col-md-6">
                        <p class="text-muted mb-1">
                            Document demandé
                        </p>

                        <p class="fw-semibold mb-0">
                            @Model.TypeDocument
                        </p>
                    </div>

                    <div class="col-md-6">
                        <p class="text-muted mb-1">
                            Date de la demande
                        </p>

                        <p class="fw-semibold mb-0">
                            @Model.DateDemande.ToString("dd/MM/yyyy à HH:mm")
                        </p>
                    </div>

                    <div class="col-12">
                        <p class="text-muted mb-1">
                            Votre message
                        </p>

                        <div class="border rounded bg-light p-3">
                            @if (string.IsNullOrWhiteSpace(Model.Message))
                            {
                                <span class="text-muted">
                                    Aucun message
                                </span>
                            }
                            else
                            {
                                <span style="white-space: pre-wrap;">
                                    @Model.Message
                                </span>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <p class="text-muted mb-1">
                            Statut
                        </p>

                        @if (Model.Statut == "En attente")
                        {
                            <span class="badge bg-warning text-dark">
                                En attente
                            </span>
                        }
                        else if (Model.Statut == "Traitée" ||
                                 Model.Statut == "Acceptée")
                        {
                            <span class="badge bg-success">
                                Traitée
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Refusée
                            </span>
                        }
                    </div>

                    @if (Model.DateTraitement.HasValue)
                    {
                        <div class="col-md-6">
                            <p class="text-muted mb-1">
                                Date de traitement
                            </p>

                            <p class="fw-semibold mb-0">
                                @Model.DateTraitement.Value
                                    .ToString("dd/MM/yyyy à HH:mm")
                            </p>
                        </div>
                    }

                </div>

                @if (Model.DocumentStagiaire != null)
                {
                    <hr class="my-4" />

                    <div class="alert alert-success mb-0">

                        <h5 class="alert-heading">
                            <i class="bi bi-check-circle-fill me-1"></i>
                            Document disponible
                        </h5>

                        <p class="mb-3">
                            Le responsable a transmis le document demandé.
                        </p>

                        <a href="@Model.DocumentStagiaire.CheminFichier"
                           target="_blank"
                           class="btn btn-success">

                            <i class="bi bi-download me-1"></i>
                            Télécharger le document
                        </a>

                    </div>
                }
                else if (Model.Statut == "Refusée")
                {
                    <hr class="my-4" />

                    <div class="alert alert-danger mb-0">
                        Cette demande a été refusée.
                    </div>
                }
                else
                {
                    <hr class="my-4" />

                    <div class="alert alert-warning mb-0">
                        Votre demande est en cours de traitement.
                    </div>
                }

                <div class="mt-4">
                    <a asp-action="Index"
                       class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Retour à mes demandes
                    </a>
                </div>

            </div>

        </div>

    </div>
</div>