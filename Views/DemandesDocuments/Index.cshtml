@model List<GestionStagiaires.Models.DemandeDocument>

@{
    ViewData["Title"] = "Mes demandes";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="fw-bold mb-1">
            <i class="bi bi-file-earmark-text-fill me-2"></i>
            Mes demandes
        </h1>

        <p class="text-muted mb-0">
            Consultez le statut de vos demandes de documents.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-success">
        <i class="bi bi-plus-circle-fill me-1"></i>
        Nouvelle demande
    </a>

    </div>

    @if (TempData["Succes"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
            role="alert">

            @TempData["Succes"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            Vous n’avez encore envoyé aucune demande.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <div class="card border-0 shadow-sm">
        <div class="table-responsive">

            <div class="card border-0 shadow-sm">
    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-dark">
                <tr>
                    <th>Document</th>
                    <th>Date</th>
                    <th>Statut</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var demande in Model)
                {
                    <tr>

                        <td class="fw-semibold">
                            @demande.TypeDocument
                        </td>

                        <td>
                            @(demande.DateDemande
                                .ToString("dd/MM/yyyy HH:mm"))
                        </td>

                        <td>
                            @if (demande.Statut == "En attente")
                            {
                                <span class="badge bg-warning text-dark">
                                    En attente
                                </span>
                            }
                            else if (demande.Statut == "Traitée" ||
                                     demande.Statut == "Acceptée")
                            {
                                <span class="badge bg-success">
                                    Traitée
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Refusée
                                </span>
                            }
                        </td>

                        <td class="text-end">
                            <a asp-action="DetailsStagiaire"
                               asp-route-id="@demande.Id"
                               class="btn btn-sm btn-outline-primary">

                                <i class="bi bi-eye-fill me-1"></i>
                                Voir
                            </a>
                        </td>

                    </tr>
                }
            </tbody>

        </table>

    </div>
</div>
        </div>
    </div>

            </div>
        </div>
    </div>
}