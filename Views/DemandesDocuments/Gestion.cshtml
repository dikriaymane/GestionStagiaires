@model List<GestionStagiaires.Models.DemandeDocument>

@{
    ViewData["Title"] = "Gestion des demandes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">
            <i class="bi bi-inbox-fill me-2"></i>
            Gestion des demandes
        </h1>

        <p class="text-muted mb-0">
            Consultez et traitez les demandes envoyées par les stagiaires.
        </p>
    </div>
</div>

@if (TempData["Succes"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        @TempData["Succes"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Fermer">
        </button>
    </div>
}

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info">
        Aucune demande n’a encore été envoyée.
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">
                        <tr>
                            <th>Stagiaire</th>
                            <th>Email</th>
                            <th>Document</th>
                            <th>Message</th>
                            <th>Date</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var demande in Model)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @demande.Stagiaire?.Prenom
                                    @demande.Stagiaire?.Nom
                                </td>

                                <td>
                                    @(demande.Stagiaire?.Email
                                        ?? "Non renseigné")
                                </td>

                                <td>
                                    @demande.TypeDocument
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(demande.Message)
                                        ? "Aucun message"
                                        : demande.Message)
                                </td>

                                <td>
                                    @(demande.DateDemande
                                        .ToString("dd/MM/yyyy HH:mm"))
                                </td>

                                <td>
                                    @if (demande.Statut == "Acceptée")
                                    {
                                        <span class="badge bg-success">
                                            Acceptée
                                        </span>
                                    }
                                    else if (demande.Statut == "Refusée")
                                    {
                                        <span class="badge bg-danger">
                                            Refusée
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            En attente
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (demande.Statut == "En attente")
                                    {
                                        <div class="d-flex gap-2">

                                            <form asp-action="Accepter"
                                                  asp-route-id="@demande.Id"
                                                  method="post">

                                                <button type="submit"
                                                        class="btn btn-success btn-sm">
                                                    <i class="bi bi-check-lg"></i>
                                                    Accepter
                                                </button>

                                            </form>

                                            <form asp-action="Refuser"
                                                  asp-route-id="@demande.Id"
                                                  method="post">

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm">
                                                    <i class="bi bi-x-lg"></i>
                                                    Refuser
                                                </button>

                                            </form>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Traitée
                                        </span>
                                    }
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>
    </div>
}