@model GestionStagiaires.Models.DemandeDocument

@{
    ViewData["Title"] = "Demander un document";
}

<div class="row justify-content-center">
    <div class="col-lg-7">

        <div class="card border-0 shadow-sm">

            <div class="card-header onee-form-header text-white">
                <h3 class="mb-0">
                    <i class="bi bi-file-earmark-plus-fill me-2"></i>
                    Demander un document
                </h3>
            </div>

            <div class="card-body p-4">

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="mb-3">
                        <label asp-for="TypeDocument"
                               class="form-label">
                        </label>

                        <select asp-for="TypeDocument"
                                class="form-select">

                            <option value="">
                                Sélectionnez un document
                            </option>

                            <option value="Attestation de stage">
                                Attestation de stage
                            </option>

                            <option value="Convention de stage">
                                Convention de stage
                            </option>

                            <option value="Certificat de stage">
                                Certificat de stage
                            </option>

                            <option value="Autre document">
                                Autre document
                            </option>

                        </select>

                        <span asp-validation-for="TypeDocument"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Message"
                               class="form-label">
                        </label>

                        <textarea asp-for="Message"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Précisez votre demande si nécessaire...">
                        </textarea>

                        <span asp-validation-for="Message"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="alert alert-info">
                        Votre demande sera transmise au responsable ONEE.
                    </div>

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-success">
                            <i class="bi bi-send-fill me-1"></i>
                            Envoyer la demande
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Annuler
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}