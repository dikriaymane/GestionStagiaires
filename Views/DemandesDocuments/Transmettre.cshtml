@model GestionStagiaires.ViewModels.TraiterDemandeViewModel

@{
    ViewData["Title"] = "Transmettre un document";

    var demande = ViewBag.Demande as GestionStagiaires.Models.DemandeDocument;
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card shadow-sm border-0">

            <div class="card-header bg-success text-white">

                <h3 class="mb-0">
                    <i class="bi bi-send-fill me-2"></i>
                    Transmission d'un document
                </h3>

            </div>

            <div class="card-body">

                <div class="alert alert-light border">

                    <h5 class="mb-3">
                        Informations de la demande
                    </h5>

                    <p>
                        <strong>Stagiaire :</strong>
                        @demande?.Stagiaire?.Prenom
                        @demande?.Stagiaire?.Nom
                    </p>

                    <p>
                        <strong>Document demandé :</strong>
                        @demande?.TypeDocument
                    </p>

                    <p>
                        <strong>Message :</strong>
                        @demande?.Message
                    </p>

                </div>

                <form asp-action="Transmettre"
                      method="post"
                      enctype="multipart/form-data">

                    <input asp-for="DemandeId" type="hidden"/>

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="mb-4">

                        <label asp-for="Fichier"
                               class="form-label">
                        </label>

                        <input asp-for="Fichier"
                               class="form-control"
                               type="file"
                               accept=".pdf"/>

                        <span asp-validation-for="Fichier"
                              class="text-danger">
                        </span>

                    </div>

                    <button class="btn btn-success">

                        <i class="bi bi-send-fill me-1"></i>

                        Transmettre le document

                    </button>

                    <a asp-action="Gestion"
                       class="btn btn-secondary">

                        Retour

                    </a>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}