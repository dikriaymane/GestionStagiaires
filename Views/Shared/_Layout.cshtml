<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GestionStagiaires</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GestionStagiaires.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark onee-navbar shadow-sm mb-4">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center"
                    asp-controller="Home"
                    asp-action="Index">

                        <img src="~/image/onee-logo.png"
                            alt="ONEE"
                            class="onee-logo me-2" />

                        <div>
                            <div class="fw-bold">ONEE</div>
                            <small class="text-white-50">
                                Gestion des stagiaires
                            </small>
                        </div>

                    </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link"
                            asp-controller="Home"
                            asp-action="Index">
                                <i class="bi bi-house-door-fill me-1"></i>
                                Accueil
                            </a>
                        </li>

                        @if (User.IsInRole("Responsable"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                asp-controller="Stagiaires"
                                asp-action="Index">
                                    <i class="bi bi-people-fill me-1"></i>
                                    Stagiaires
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                asp-controller="DemandesDocuments"
                                asp-action="Gestion">

                                    <i class="bi bi-inbox-fill me-1"></i>
                                    Demandes

                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Stagiaire"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                asp-controller="EspaceStagiaire"
                                asp-action="Index">
                                    <i class="bi bi-person-circle me-1"></i>
                                    Mon espace
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                asp-controller="DemandesDocuments"
                                asp-action="Index">

                                    <i class="bi bi-file-earmark-text me-1"></i>
                                    Mes demandes

                                </a>
                            </li>
                        }

                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - GestionStagiaires - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
