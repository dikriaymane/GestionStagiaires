@model GestionStagiaires.Models.Stagiaire

<h1>Modifier un stagiaire</h1>

<form asp-controller="Stagiaires"
      asp-action="Edit"
      method="post">

    <input type="hidden" asp-for="Id" />

    <div>
        <label asp-for="Nom"></label>
        <input asp-for="Nom" />
    </div>

    <br />

    <div>
        <label asp-for="Prenom"></label>
        <input asp-for="Prenom" />
    </div>

    <br />

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" />
    </div>

    <br />

    <button type="submit">Enregistrer</button>

    <a asp-controller="Stagiaires"
       asp-action="Index">
        Annuler
    </a>
</form>