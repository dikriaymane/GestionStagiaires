@model GestionStagiaires.Models.Stagiaire

<h1 class="mb-4">Détails du stagiaire</h1>

<div class="card">
    <div class="card-body">

        <p>
            <strong>Identifiant :</strong>
            @Model.Id
        </p>

        <p>
            <strong>Nom :</strong>
            @Model.Nom
        </p>

        <p>
            <strong>Prénom :</strong>
            @Model.Prenom
        </p>

        <p>
            <strong>Email :</strong>
            @Model.Email
        </p>

        <p>
            <strong>Tuteur :</strong>
            @Model.Tuteur
        </p>

        <p>
            <strong>Service :</strong>
            @Model.Service
        </p>

        <p>
            <strong>Date de début :</strong>
            @(Model.DateDebut?.ToString("dd/MM/yyyy") ?? "Non définie")
        </p>

        <p>
            <strong>Date de fin :</strong>
            @(Model.DateFin?.ToString("dd/MM/yyyy") ?? "Non définie")
        </p>

    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Modifier
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Retour à la liste
    </a>
</div>



