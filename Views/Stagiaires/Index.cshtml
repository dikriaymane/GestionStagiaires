@model List<GestionStagiaires.Models.Stagiaire>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Liste des stagiaires</h1>

    <a asp-action="Create"
       class="btn btn-success">
        Ajouter un stagiaire
    </a>
</div>

@if (TempData["Succes"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Succes"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Fermer">
        </button>
    </div>
}

<form asp-action="Index"
      method="get"
      class="row g-2 mb-4">

    <div class="col-md-5">
        <input type="text"
               name="recherche"
               value="@ViewBag.Recherche"
               class="form-control"
               placeholder="Rechercher par nom, prénom, email ou par tuteur" />
    </div>

        <div class="col-md-3">
        <select name="tri" class="form-select">
            <option value="">Identifiant croissant</option>

            <option value="id_desc"
                    selected="@(ViewBag.Tri == "id_desc")">
                Identifiant décroissant
            </option>

            <option value="nom"
                    selected="@(ViewBag.Tri == "nom")">
                Nom
            </option>

            <option value="prenom"
                    selected="@(ViewBag.Tri == "prenom")">
                Prénom
            </option>

            <option value="email"
                    selected="@(ViewBag.Tri == "email")">
                Email
            </option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit"
                class="btn btn-primary">
            Rechercher
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Réinitialiser
        </a>
    </div>
</form>

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info">
        Aucun stagiaire trouvé.
    </div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Identifiant</th>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Email</th>
                <th>Tuteur</th>
                <th>Service</th>
                <th>Date de début</th>
                <th>Date de fin</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var stagiaire in Model)
            {
                <tr>
                    <td>@stagiaire.Id</td>
                    <td>@stagiaire.Nom</td>
                    <td>@stagiaire.Prenom</td>
                    <td>@stagiaire.Email</td>
                    <td>@stagiaire.Tuteur</td>
                    <td>@(stagiaire.Service ?? "Non renseigné")</td>
                    <td>
                        @(stagiaire.DateDebut?.ToString("dd/MM/yyyy") ?? "Non définie")
                    </td>

                    <td>
                        @(stagiaire.DateFin?.ToString("dd/MM/yyyy") ?? "Non définie")
                    </td>
                 
                    <td>
                    <a asp-action="Details"
                    asp-route-id="@stagiaire.Id"
                    class="btn btn-info btn-sm">
                        Détails
                    </a>

                    <a asp-action="Edit"
                    asp-route-id="@stagiaire.Id"
                    class="btn btn-warning btn-sm">
                        Modifier
                    </a>

                    <a asp-action="Delete"
                    asp-route-id="@stagiaire.Id"
                    class="btn btn-danger btn-sm">
                        Supprimer
                    </a>
                </td>
                </tr>
            }
        </tbody>
    </table>

    @if (ViewBag.NombrePages > 1)
    {
        <nav>
            <ul class="pagination">

                @if (ViewBag.PageActuelle > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                        asp-action="Index"
                        asp-route-page="@(ViewBag.PageActuelle - 1)"
                        asp-route-recherche="@ViewBag.Recherche"
                        asp-route-tri="@ViewBag.Tri">
                            Précédent
                        </a>
                    </li>
                }

                @for (int i = 1; i <= ViewBag.NombrePages; i++)
                {
                    <li class="page-item @(i == ViewBag.PageActuelle ? "active" : "")">
                        <a class="page-link"
                        asp-action="Index"
                        asp-route-page="@i"
                        asp-route-recherche="@ViewBag.Recherche"
                        asp-route-tri="@ViewBag.Tri">
                            @i
                        </a>
                    </li>
                }

                @if (ViewBag.PageActuelle < ViewBag.NombrePages)
                {
                    <li class="page-item">
                        <a class="page-link"
                        asp-action="Index"
                        asp-route-page="@(ViewBag.PageActuelle + 1)"
                        asp-route-recherche="@ViewBag.Recherche"
                        asp-route-tri="@ViewBag.Tri">
                            Suivant
                        </a>
                    </li>
                }

            </ul>
        </nav>
    }
}