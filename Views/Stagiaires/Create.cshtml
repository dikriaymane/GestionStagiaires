@model GestionStagiaires.Models.Stagiaire

<h1>Ajouter un stagiaire</h1>

<form>
    <div>
        <label>Nom</label>
        <input type="text" name="Nom" />
    </div>

    <br />

    <div>
        <label>Prénom</label>
        <input type="text" name="Prenom" />
    </div>

    <br />

    <div>
        <label>Email</label>
        <input type="email" name="Email" />
    </div>

    <br />

    <button type="submit">Ajouter</button>
</form>