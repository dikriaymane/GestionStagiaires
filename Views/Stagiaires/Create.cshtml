@model GestionStagiaires.Models.Stagiaire

<h1>Ajouter un stagiaire</h1>

<form asp-controller="Stagiaires"
      asp-action="Create"
      method="post">

    <div>
        <label asp-for="Nom"></label>
        <input asp-for="Nom" />
    </div>

    <br />

    <div>
        <label asp-for="Prenom"></label>
        <input asp-for="Prenom" />
    </div>

    <br />

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" />
    </div>

    <br />

    <button type="submit">Ajouter</button>
</form>