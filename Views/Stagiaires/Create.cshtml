@model GestionStagiaires.Models.Stagiaire

<h1>Ajouter un stagiaire</h1>

<form asp-action="Create" method="post">

    <div>
        <label asp-for="Nom"></label>
        <input asp-for="Nom" />
        <span asp-validation-for="Nom"></span>
    </div>

    <br />

    <div>
        <label asp-for="Prenom"></label>
        <input asp-for="Prenom" />
        <span asp-validation-for="Prenom"></span>
    </div>

    <br />

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>

    <br />

    <button type="submit">Ajouter</button>

    <a asp-action="Index">Annuler</a>
</form>