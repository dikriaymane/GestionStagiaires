@model GestionStagiaires.ViewModels.DashboardResponsableViewModel

@{
    ViewData["Title"] = "Tableau de bord";
}

<div class="mb-4">
    <h1 class="fw-bold mb-1">
        <i class="bi bi-speedometer2 me-2"></i>
        Tableau de bord
    </h1>

    <p class="text-muted mb-0">
        Vue d’ensemble de la gestion des stages.
    </p>
</div>

<div class="row g-4 mb-5">

    <div class="col-md-6 col-xl-3">
        <div class="card dashboard-card border-0 shadow-sm h-100">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted mb-2">Total stagiaires</p>

                        <h2 class="fw-bold mb-0">
                            @Model.TotalStagiaires
                        </h2>
                    </div>

                    <div class="dashboard-icon bg-primary-subtle text-primary">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card dashboard-card border-0 shadow-sm h-100">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted mb-2">Stages en cours</p>

                        <h2 class="fw-bold mb-0">
                            @Model.StagesEnCours
                        </h2>
                    </div>

                    <div class="dashboard-icon bg-success-subtle text-success">
                        <i class="bi bi-play-circle-fill"></i>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card dashboard-card border-0 shadow-sm h-100">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted mb-2">Stages terminés</p>

                        <h2 class="fw-bold mb-0">
                            @Model.StagesTermines
                        </h2>
                    </div>

                    <div class="dashboard-icon bg-secondary-subtle text-secondary">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card dashboard-card border-0 shadow-sm h-100">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted mb-2">Stages à venir</p>

                        <h2 class="fw-bold mb-0">
                            @Model.StagesAVenir
                        </h2>
                    </div>

                    <div class="dashboard-icon bg-warning-subtle text-warning">
                        <i class="bi bi-calendar-event-fill"></i>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>

<div class="row g-4">

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">

            <div class="card-header bg-white border-0 p-4 pb-0">
                <h4 class="mb-0">
                    <i class="bi bi-inbox-fill me-2"></i>
                    Demandes de documents
                </h4>
            </div>

            <div class="card-body p-4">

                <div class="d-flex align-items-center justify-content-between mb-4">

                    <div>
                        <p class="text-muted mb-1">
                            Demandes en attente
                        </p>

                        <h2 class="fw-bold mb-0">
                            @Model.DemandesEnAttente
                        </h2>
                    </div>

                    @if (Model.DemandesEnAttente > 0)
                    {
                        <span class="badge bg-danger fs-6">
                            Action requise
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success fs-6">
                            À jour
                        </span>
                    }

                </div>

                <a asp-controller="DemandesDocuments"
                   asp-action="Gestion"
                   class="btn btn-primary">
                    <i class="bi bi-arrow-right-circle me-1"></i>
                    Gérer les demandes
                </a>

            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">

            <div class="card-header bg-white border-0 p-4 pb-0">
                <h4 class="mb-0">
                    <i class="bi bi-lightning-charge-fill me-2"></i>
                    Accès rapides
                </h4>
            </div>

            <div class="card-body p-4">

                <div class="d-grid gap-3">

                    <a asp-action="Index"
                       class="btn btn-outline-primary text-start">
                        <i class="bi bi-people-fill me-2"></i>
                        Consulter les stagiaires
                    </a>

                    <a asp-action="Create"
                       class="btn btn-outline-success text-start">
                        <i class="bi bi-person-plus-fill me-2"></i>
                        Ajouter un stagiaire
                    </a>

                    <a asp-controller="Notifications"
                       asp-action="Index"
                       class="btn btn-outline-secondary text-start">
                        <i class="bi bi-bell-fill me-2"></i>
                        Consulter les notifications
                    </a>

                </div>

            </div>
        </div>
    </div>

</div>